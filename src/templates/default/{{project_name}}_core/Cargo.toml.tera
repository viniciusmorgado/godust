[workspace]
resolver = "2"
members = ["{{ project_name }}_lib"]

# Convention: ALL template dependencies live in [workspace.dependencies] below and are inherited via `{ workspace = true }` in the member crate — never declare a dependency directly in a member's [dependencies]/[dev-dependencies].
[workspace.dependencies]
godot = { version = "{{ godot_version }}", features = ["register-docs"] }
criterion = { version = "{{ criterion_version }}", features = ["html_reports"] }
